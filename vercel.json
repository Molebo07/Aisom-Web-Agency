{
  "rewrites": [
    { "source": "/~oauth/:path*", "destination": "https://id-preview--b91d4eb8-151e-4227-b501-c8e3d458e90d.lovable.app/~oauth/:path*" },
    { "source": "/((?!assets|og-image|favicon|robots|sitemap|placeholder).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
